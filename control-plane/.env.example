# Local-development defaults used by compose.yaml. These are NOT secrets:
# they only protect containers running on your own machine.
# Nothing here is required: compose.yaml has the same defaults built in.
# To override, copy this file to .env (git-ignored) and edit it.

POSTGRES_USER=controlplane
POSTGRES_PASSWORD=controlplane
POSTGRES_DB=controlplane

RABBITMQ_USER=controlplane
RABBITMQ_PASSWORD=controlplane

# Worker simulator behaviour
WORKER_FAIL_RATE=0
WORKER_MIN_DELAY_MS=500
WORKER_MAX_DELAY_MS=3000

# Optional: lets Swagger UI (docker compose --profile docs) call the API.
# Leave empty to keep CORS off.
CORS_ALLOWED_ORIGIN=
