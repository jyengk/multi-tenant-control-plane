# Local-development defaults used by compose.yaml. These are not secrets.
# Copy to .env to override; compose reads .env automatically.

POSTGRES_USER=controlplane
POSTGRES_PASSWORD=controlplane
POSTGRES_DB=controlplane

RABBITMQ_USER=controlplane
RABBITMQ_PASSWORD=controlplane

# Worker simulator behaviour
WORKER_FAIL_RATE=0
WORKER_MIN_DELAY_MS=500
WORKER_MAX_DELAY_MS=3000
