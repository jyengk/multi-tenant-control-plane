    {
      "name": "Routing",
      "item": [
        {
          "name": "Wrong method on tenant (405)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants",
                "{{tenantId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 405\", () => pm.response.to.have.status(405));",
                  "pm.test(\"error code method_not_allowed\", () => pm.expect(pm.response.json().error.code).to.eql(\"method_not_allowed\"));"
                ]
              }
            }
          ]
        },
