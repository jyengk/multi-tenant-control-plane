{
  "info": {
    "name": "Tenant Control Plane (skeleton)",
    "description": "For the skeleton stage: every API route should reach its handler and answer 501 not_implemented. Start the server with `go run ./cmd/control-plane`. Switch to the full collection once handlers are implemented.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tenantId",
      "value": "abc-123"
    },
    {
      "key": "taskId",
      "value": "task-1"
    }
  ],
  "item": [
    {
      "name": "Tenants",
      "item": [
        {
          "name": "Create tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"acme-eu\",\n  \"name\": \"Acme EU\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 501\", () => pm.response.to.have.status(501));",
                  "pm.test(\"reached createTenant\", () => pm.expect(pm.response.json().error.message).to.include(\"createTenant\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "List tenants",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants?status=active&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "active"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 501\", () => pm.response.to.have.status(501));",
                  "pm.test(\"reached listTenants\", () => pm.expect(pm.response.json().error.message).to.include(\"listTenants\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get tenant",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants",
                "{{tenantId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 501\", () => pm.response.to.have.status(501));",
                  "pm.test(\"reached getTenant\", () => pm.expect(pm.response.json().error.message).to.include(\"getTenant\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update tenant",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants",
                "{{tenantId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": 1,\n  \"name\": \"Acme Europe\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 501\", () => pm.response.to.have.status(501));",
                  "pm.test(\"reached updateTenant\", () => pm.expect(pm.response.json().error.message).to.include(\"updateTenant\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete tenant",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants",
                "{{tenantId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 501\", () => pm.response.to.have.status(501));",
                  "pm.test(\"reached deleteTenant\", () => pm.expect(pm.response.json().error.message).to.include(\"deleteTenant\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tasks",
