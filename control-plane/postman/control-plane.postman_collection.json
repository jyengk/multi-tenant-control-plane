{
  "info": {
    "name": "Tenant Control Plane",
    "description": "Requests for the control-plane API. Start the server with `go run ./cmd/control-plane --dry-run`.\n\nRun the Tenant lifecycle folder top to bottom, waiting a few seconds after create, update and delete for the simulated worker. Responses save tenantId, version and taskId into collection variables automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "slug",
      "value": "acme-eu"
    },
    {
      "key": "tenantId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "version",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Tenant lifecycle",
      "item": [
        {
          "name": "1. Create tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"{{slug}}\",\n  \"name\": \"Acme Corporation (EU)\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Starts a deploy task. Saves tenantId, version and taskId into collection variables."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// fresh slug each run so you can re-run the collection",
                  "pm.collectionVariables.set(\"slug\", \"acme-\" + Math.floor(Math.random() * 1e6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"tenant provisioning\", () => pm.expect(pm.response.json().tenant.status).to.eql(\"provisioning\"));",
                  "const b = pm.response.json();",
                  "if (b.tenant) {",
                  "  pm.collectionVariables.set(\"tenantId\", b.tenant.id);",
                  "  pm.collectionVariables.set(\"version\", b.tenant.version);",
                  "  pm.collectionVariables.set(\"taskId\", b.task.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Create duplicate slug (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"{{slug}}\",\n  \"name\": \"Someone else\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"error code tenant_already_exists\", () => pm.expect(pm.response.json().error.code).to.eql(\"tenant_already_exists\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Get tenant",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants",
                "{{tenantId}}"
              ]
            },
            "description": "Run this a few seconds after create: status moves provisioning \u2192 active and version goes 1 \u2192 2. Saves the latest version."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "if (b.version) { pm.collectionVariables.set(\"version\", b.version); }",
                  "console.log(\"tenant status:\", b.status, \"version:\", b.version);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. List tenants",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. List active tenants",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants?status=active&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "active"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Update tenant (uses saved version)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants",
                "{{tenantId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{version}},\n  \"name\": \"Acme Europe\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Only allowed when the tenant is active. Run '3. Get tenant' first so {{version}} is current."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));",
                  "const b = pm.response.json();",
                  "if (b.tenant) {",
                  "  pm.collectionVariables.set(\"tenantId\", b.tenant.id);",
                  "  pm.collectionVariables.set(\"version\", b.tenant.version);",
                  "  pm.collectionVariables.set(\"taskId\", b.task.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Update with stale version (409)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants",
                "{{tenantId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": 1,\n  \"name\": \"Stale\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "tenant_version_conflict if the tenant is active; tenant_update_not_allowed if it is still busy."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"conflict or not allowed\", () => pm.expect([\"tenant_version_conflict\",\"tenant_update_not_allowed\"]).to.include(pm.response.json().error.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Delete tenant",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants",
                "{{tenantId}}"
              ]
            },
            "description": "Allowed from active or failed. Tenant goes to destroying, then destroyed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", () => pm.response.to.have.status(202));",
                  "const b = pm.response.json();",
                  "if (b.tenant) {",
                  "  pm.collectionVariables.set(\"tenantId\", b.tenant.id);",
                  "  pm.collectionVariables.set(\"version\", b.tenant.version);",
                  "  pm.collectionVariables.set(\"taskId\", b.task.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "9. Delete again (409)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/{{tenantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants",
                "{{tenantId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"error code tenant_update_not_allowed\", () => pm.expect(pm.response.json().error.code).to.eql(\"tenant_update_not_allowed\"));"
                ]
              }
            }
          ]
        }
      ]
    },
